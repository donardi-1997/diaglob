# Production and sandbox credentials are distinct. Never commit real values.
# Configure server deployment secrets before activating the notification destination.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
# Notification destination SIGNING SECRET (not the API key).
PADDLE_WEBHOOK_SECRET=
# Dedicated secret for the new live fulfillment notification destination.
# Preserve PADDLE_WEBHOOK_SECRET for the existing checkout signing/legacy route.
PADDLE_FULFILLMENT_WEBHOOK_SECRET=
# Public URL to configure in Paddle > Events > Notifications:
# https://api.diaglob.tech/api/billing/paddle/notifications
# Required event subscriptions:
# customer.created, customer.updated, subscription.created,
# subscription.updated, subscription.canceled, transaction.completed
# Additional status changes may also be subscribed, e.g. subscription.paused.
# Never remove the destination or any persistent Paddle entities during testing.
