[Unit]
Description=Diaglob Automation Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/diaglob/app/backend
EnvironmentFile=/etc/diaglob/diaglob.env
ExecStart=/opt/diaglob/app/backend/.venv/bin/python -m app.automation_worker
Restart=always
RestartSec=5
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
