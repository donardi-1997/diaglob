{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDiaglobKnowledgeDocuments",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::diaglob-knowledge-765761474007-us-east-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": "organizations/*/knowledge-bases/*/documents/*"
        }
      }
    },
    {
      "Sid": "ManageDiaglobKnowledgeDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::diaglob-knowledge-765761474007-us-east-2/organizations/*/knowledge-bases/*/documents/*"
    },
    {
      "Sid": "CreateManagedS3VectorIndexes",
      "Effect": "Allow",
      "Action": [
        "s3vectors:CreateIndex",
        "s3vectors:TagResource"
      ],
      "Resource": "arn:aws:s3vectors:us-east-2:765761474007:bucket/diaglob-vectors-765761474007-us-east-2/index/diaglob-prod-kb-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/diaglob:managed-by": "diaglob-backend",
          "aws:RequestTag/diaglob:environment": "production"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "diaglob:managed-by",
            "diaglob:environment",
            "diaglob:organization_id",
            "diaglob:knowledge_base_id"
          ]
        }
      }
    },
    {
      "Sid": "ManageOwnedS3VectorIndexes",
      "Effect": "Allow",
      "Action": [
        "s3vectors:GetIndex",
        "s3vectors:DeleteIndex",
        "s3vectors:ListTagsForResource"
      ],
      "Resource": "arn:aws:s3vectors:us-east-2:765761474007:bucket/diaglob-vectors-765761474007-us-east-2/index/diaglob-prod-kb-*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/diaglob:managed-by": "diaglob-backend",
          "aws:ResourceTag/diaglob:environment": "production"
        }
      }
    },
    {
      "Sid": "CreateManagedBedrockKnowledgeBases",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateKnowledgeBase",
        "bedrock:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/diaglob:managed-by": "diaglob-backend",
          "aws:RequestTag/diaglob:environment": "production"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "diaglob:managed-by",
            "diaglob:environment",
            "diaglob:organization_id",
            "diaglob:knowledge_base_id"
          ]
        }
      }
    },
    {
      "Sid": "ListBedrockKnowledgeBases",
      "Effect": "Allow",
      "Action": "bedrock:ListKnowledgeBases",
      "Resource": "*"
    },
    {
      "Sid": "ManageOwnedBedrockKnowledgeBases",
      "Effect": "Allow",
      "Action": [
        "bedrock:DeleteKnowledgeBase",
        "bedrock:ListTagsForResource"
      ],
      "Resource": "arn:aws:bedrock:us-east-2:765761474007:knowledge-base/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/diaglob:managed-by": "diaglob-backend",
          "aws:ResourceTag/diaglob:environment": "production"
        }
      }
    },
    {
      "Sid": "ReadManagedBedrockKnowledgeBasesForCleanup",
      "Effect": "Allow",
      "Action": "bedrock:GetKnowledgeBase",
      "Resource": "arn:aws:bedrock:us-east-2:765761474007:knowledge-base/*"
    },
    {
      "Sid": "ManageDataSourcesForOwnedKnowledgeBases",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateDataSource",
        "bedrock:GetDataSource",
        "bedrock:DeleteDataSource",
        "bedrock:ListDataSources",
        "bedrock:StartIngestionJob",
        "bedrock:GetIngestionJob"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-2:765761474007:knowledge-base/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/diaglob:managed-by": "diaglob-backend",
          "aws:ResourceTag/diaglob:environment": "production"
        }
      }
    },
    {
      "Sid": "RetrieveFromOwnedKnowledgeBases",
      "Effect": "Allow",
      "Action": "bedrock:Retrieve",
      "Resource": "arn:aws:bedrock:us-east-2:765761474007:knowledge-base/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/diaglob:managed-by": "diaglob-backend",
          "aws:ResourceTag/diaglob:environment": "production"
        }
      }
    },
    {
      "Sid": "PreserveLegacyKnowledgeBaseAccess",
      "Effect": "Allow",
      "Action": [
        "bedrock:StartIngestionJob",
        "bedrock:GetIngestionJob",
        "bedrock:Retrieve"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-2:765761474007:knowledge-base/RDAQY1JNQ8",
        "arn:aws:bedrock:us-east-2:765761474007:knowledge-base/RDAQY1JNQ8/data-source/RCH1VO2AFZ"
      ]
    },
    {
      "Sid": "PassRoleToBedrock",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::765761474007:role/DiaglobBedrockKnowledgeBaseRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadManagedS3VectorIndexesForCleanup",
      "Effect": "Allow",
      "Action": [
        "s3vectors:GetIndex"
      ],
      "Resource": "arn:aws:s3vectors:us-east-2:765761474007:bucket/diaglob-vectors-765761474007-us-east-2/index/diaglob-prod-kb-*"
    }
  ]
}
