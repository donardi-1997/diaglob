# Copy to frontend/.env.local (or inject these values in the build environment).
# Use the client-side Paddle token from the intended Paddle environment.
# A live_ token is public-facing and must never be replaced by a server API key.
VITE_PADDLE_CLIENT_TOKEN=

# Set explicitly to "production" for the live Paddle account or "sandbox" for tests.
VITE_PADDLE_ENVIRONMENT=production
